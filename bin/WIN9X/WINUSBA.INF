; WINUSBA.INF - WINDRV 1.1 WINUSB for Windows 95, 98 and ME: Sound, video and game controllers
; USB Audio Class 1.0 and 2.0 devices and USB MIDI devices; WINSOUND.DRV (installed with the
; controller) plays and records through them.

[Version]
Signature="$CHICAGO$"
Class=MEDIA
Provider=%Provider%

[DestinationDirs]
DefaultDestDir=11

[Manufacturer]
%Provider%=WINDRV

[WINDRV]
%UAC2.Desc%=WINUSB.Dev,WINUSB\AUDIO20
%UAC1.Desc%=WINUSB.Dev,WINUSB\AUDIO10
%MIDI.Desc%=WINUSB.Dev,WINUSB\MIDI
%Audio.Desc%=WINUSB.Dev,WINUSB\AUDIO

; served by WINUSB.VXD (the enumerator); its files came with the controller (WINUSB.INF)
[WINUSB.Dev]
AddReg=WINUSB.Dev.AddReg

[WINUSB.Dev.AddReg]
HKR,,DevLoader,,WINUSB.VXD

[Strings]
Provider="WINDRV"
DiskName="WINDRV WINUSB 1.1 disk"
UAC2.Desc="WINUSB USB Audio Class 2.0 Device"
UAC1.Desc="WINUSB USB Audio Class 1.0 Device"
MIDI.Desc="WINUSB USB MIDI Device"
Audio.Desc="WINUSB USB Audio Device"
