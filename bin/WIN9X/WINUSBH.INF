; WINUSBH.INF - WINDRV 1.1 WINUSB for Windows 95, 98 and ME: Human Interface Devices
; Tablets and touch screens (absolute pointers) and the other USB HID devices; keyboards
; and mice are in WINKBD.INF and WINMOU.INF.

[Version]
Signature="$CHICAGO$"
Class=HID
ClassGUID={745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider=%Provider%

[ClassInstall]
AddReg=Class.AddReg
CopyFiles=Class.Copy

[Class.AddReg]
HKR,,,,"%ClassName%"
HKR,,Installer,,"WINDRVCI.DLL,ClassInstall"
HKR,,Icon,,"3"
HKR,,NoInstallClass,,1

[Class.Copy]
WINDRVCI.DLL

[DestinationDirs]
DefaultDestDir=11
Class.Copy=11

[SourceDisksNames]
1=%DiskName%,,0

[SourceDisksFiles]
WINDRVCI.DLL=1

[Manufacturer]
%Provider%=WINDRV

[WINDRV]
%Tablet.Desc%=WINUSB.Dev,WINUSB\TABLET
%HID.Desc%=WINUSB.Dev,WINUSB\HID

; served by WINUSB.VXD (the enumerator); its files came with the controller (WINUSB.INF)
[WINUSB.Dev]
AddReg=WINUSB.Dev.AddReg

[WINUSB.Dev.AddReg]
HKR,,DevLoader,,WINUSB.VXD

[Strings]
Provider="WINDRV"
DiskName="WINDRV WINUSB 1.1 disk"
ClassName="Human Interface Devices"
Tablet.Desc="WINUSB USB HID Tablet / Touch Screen"
HID.Desc="WINUSB USB HID Device"
