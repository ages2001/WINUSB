; WINUSBS.INF - WINDRV 1.0 WINUSB for Windows 95, 98 and ME: System devices
; Thunderbolt 3 / USB4 host interfaces (NHI: the USB, PCI Express and NVMe tunnels behind
; them) and Intel LPSS I2C controllers (HID over I2C touchpads and touch screens), driven by
; WINUSB.VXD.

[Version]
Signature="$CHICAGO$"
Class=System
Provider=%Provider%

[DestinationDirs]
DefaultDestDir=11

[SourceDisksNames]
1=%DiskName%,,0

[SourceDisksFiles]
WINUSB.VXD=1
WIN4G.VXD=1

[Manufacturer]
%Provider%=WINDRV

[WINDRV]
%I2C.Desc%=WINUSBS.Dev,PCI\VEN_8086&CC_0C8000
%I2C.Desc%=WINUSBS.Dev,PCI\VEN_8086&CC_0C80
%NHI.Desc%=WINUSBS.Dev,PCI\VEN_8086&DEV_1513
