[WINUSBS.Dev]
CopyFiles=WINUSBS.Copy
AddReg=WINUSBS.AddReg
UpdateInis=WINUSBS.Inis

[WINUSBS.AddReg]
HKR,,DevLoader,,WINUSB.VXD
HKR,,Options,,""

[WINUSBS.Copy]
WINUSB.VXD
WIN4G.VXD

[WINUSBS.Inis]
system.ini,386Enh,,"device=win4g.vxd"

[Strings]
Provider="WINDRV"
DiskName="WINDRV WINUSB 1.0 disk"
I2C.Desc="WINUSB Intel LPSS I2C Controller (HID over I2C)"
NHI.Desc="WINUSB Thunderbolt 3 / USB4 Host Interface (NHI)"
