; WINUSBD.INF - WINDRV 1.0 WINUSB for Windows 95, 98 and ME: Disk drives
; USB mass storage devices: the I/O Supervisor loads the WINUSB.PDR port driver for them,
; which gives every partition a 32-bit drive letter.

[Version]
Signature="$CHICAGO$"
Class=DiskDrive
Provider=%Provider%

[DestinationDirs]
DefaultDestDir=11

[Manufacturer]
%Provider%=WINDRV

[WINDRV]
%UAS.Desc%=WINUSB.Disk,WINUSB\UAS
%BOT.Desc%=WINUSB.Disk,WINUSB\BOT
%Disk.Desc%=WINUSB.Disk,WINUSB\STORAGE

; WINUSB.PDR was installed with the controller (WINUSB.INF): nothing to copy, the install is silent
[WINUSB.Disk]
AddReg=WINUSB.Disk.AddReg

[WINUSB.Disk.AddReg]
HKR,,DevLoader,,*IOS
HKR,,PortDriver,,WINUSB.PDR

[Strings]
Provider="WINDRV"
DiskName="WINDRV WINUSB 1.0 disk"
UAS.Desc="WINUSB USB Attached SCSI (UAS) Disk"
BOT.Desc="WINUSB USB Mass Storage Disk (Bulk-Only Transport)"
Disk.Desc="WINUSB USB Mass Storage Disk"
