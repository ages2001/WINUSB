#include <windows.h>

1 ICON usb.ico

2 DIALOG 30, 30, 220, 50
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Save report"
BEGIN
    LTEXT "File name:", -1, 6, 9, 40, 10
    EDITTEXT 100, 48, 7, 166, 12, ES_AUTOHSCROLL
    DEFPUSHBUTTON "OK", IDOK, 108, 28, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 164, 28, 50, 14
END

3 DIALOG 30, 30, 220, 66
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Mouse speed"
BEGIN
    LTEXT "Pointer speed of the USB mice and touchpads:", -1, 6, 7, 208, 10
    SCROLLBAR 101, 6, 21, 168, 10
    LTEXT "", 102, 180, 22, 34, 10
    PUSHBUTTON "&Default", 103, 6, 44, 50, 14
    DEFPUSHBUTTON "OK", IDOK, 108, 44, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 164, 44, 50, 14
END
